{
  // DYNAMIC — Cloudflare Workers + Static Assets (tek deployment birimi)
  // Run: npm run dev | npm run preview | npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dynamic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dynamic",
      "database_id": "68aa5ed0-6795-4ac1-9b1d-48df817a5deb"
    }
  ],
  // Public Cloudinary values. The API secret lives in a Worker secret:
  //   npx wrangler secret put CLOUDINARY_URL
  //   npx wrangler secret put MEDIA_UPLOAD_TOKEN
  //   npx wrangler secret put ADMIN_API_KEY
  //   npx wrangler secret put BETTER_AUTH_SECRET
  //   npx wrangler secret put BETTER_AUTH_API_KEY
  "vars": {
    "CLOUDINARY_CLOUD_NAME": "di9c12gg6",
    "CLOUDINARY_UPLOAD_KEY": "657115753521274",
    "MAX_SITES": "500",
    "APP_URL": "https://app.dynamic.crty-dev.com",
    "MARKETING_URL": "https://dynamic.crty-dev.com",
    "MAIL_FROM": "DYNAMIC <no-reply@mail.crty-dev.com>",
    // Client IP for the auth rate limiter. Cloudflare overwrites this header
    // at the edge, so it cannot be spoofed by the visitor.
    "AUTH_IP_HEADERS": "cf-connecting-ip"
  },
  // Daily retention job: drops events older than the site retention window.
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
