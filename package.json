{
  "name": "dynamic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "DYNAMIC - privacy-first web analytics & RUM on Cloudflare Workers",
  "scripts": {
    "dev": "npm run build:sdk && vite",
    "build": "npm run build:sdk && vite build && vite build --config vite.app.config.ts",
    "build:sdk": "vite build --config vite.sdk.config.ts",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json --noEmit",
    "lint": "oxlint",
    "license:audit": "node scripts/license-audit.mjs",
    "test": "npm run build:sdk && node --test --test-concurrency=1 tests/*.test.mjs",
    "brand": "node scripts/brand/build.mjs",
    "cloudinary:setup": "node scripts/cloudinary/setup.mjs",
    "cloudinary:upload": "node scripts/cloudinary/setup.mjs --upload",
    "cloudinary:link": "node scripts/cloudinary/link.mjs",
    "db:migrate:local": "wrangler d1 migrations apply dynamic --local",
    "db:migrate:remote": "wrangler d1 migrations apply dynamic --remote",
    "deploy": "npm run build && wrangler deploy",
    "dev:app": "vite --config vite.app.config.ts"
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.4",
    "@cloudinary/url-gen": "^1.22.0",
    "@tanstack/react-query": "^5.104.4",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fontkit": "^2.0.4",
    "oxlint": "^1.89.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
