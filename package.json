{
  "name": "dynamic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "DYNAMIC - privacy-first web analytics & RUM on Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply dynamic --local",
    "db:migrate:remote": "wrangler d1 migrations apply dynamic --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
