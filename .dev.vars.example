# Local dev secrets — copy to .dev.vars and fill in.
#   cp .dev.vars.example .dev.vars
#
# This file is git-ignored. Never commit real secrets.
# Production equivalents live in the Worker secret store:
#   npx wrangler secret put ADMIN_API_KEY
#   npx wrangler secret put MEDIA_UPLOAD_TOKEN
#   npx wrangler secret put CLOUDINARY_URL

# --- Public values (also in wrangler.jsonc "vars") ---
CLOUDINARY_CLOUD_NAME=di9c12gg6
CLOUDINARY_UPLOAD_KEY=657115753521274

# --- Secrets (never commit) ---

# Cloudinary credential: cloudinary://<api_key>:<api_secret>@<cloud>
# Needed only if you use the media endpoints (/api/media/*).
# Get it from the Cloudinary console: API Keys -> your key -> API Secret.
# Then run: npm run cloudinary:link
CLOUDINARY_URL=cloudinary://657115753521274:<API_SECRET>@di9c12gg6

# Bearer token that guards POST /api/media/upload and /api/media/signature.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MEDIA_UPLOAD_TOKEN=<GENERATE_A_RANDOM_TOKEN>

# Bearer token that guards every /api/admin/* route (site management, goals,
# retention purge, data export and erasure). Required for the admin API.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=<GENERATE_A_RANDOM_TOKEN>

# --- DYNAMIC application (Better Auth) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=<GENERATE_A_32_CHARACTER_SECRET>

# Better Auth dashboard (https://dash.better-auth.com) ownership verification.
# Copy the key from the Better Auth dashboard and add it here and as a Worker secret.
# BETTER_AUTH_API_KEY=

# Public URLs of the two origins
APP_URL=http://localhost:5174
MARKETING_URL=http://localhost:5173

# Sender address for the verification / reset mails
MAIL_FROM=DYNAMIC <no-reply@crty-dev.com>

# Transactional mail provider (optional). Without it the mails are only
# written to the local outbox in development.
# MAIL_PROVIDER_URL=https://api.resend.com/emails
# MAIL_PROVIDER_TOKEN=<provider api key>

# Cloudflare Turnstile (optional bot protection)
# TURNSTILE_SITE_KEY=<public site key>
# TURNSTILE_SECRET_KEY=<secret key>

# DNS-over-HTTPS resolver used for the TXT verification (optional)
# DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query

# Minimum seconds between two DNS verification attempts (default 10)
# PROJECT_VERIFY_INTERVAL_MS=10000
