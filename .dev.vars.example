# Local dev secrets (this file is git-ignored; copy to .dev.vars)
# Cloudinary credential — the API secret stays on your machine and in the
# Worker secret store, never in the repo.
CLOUDINARY_URL=cloudinary://657115753521274:<API_SECRET>@di9c12gg6

# Public values (also set in wrangler.jsonc "vars")
CLOUDINARY_CLOUD_NAME=di9c12gg6
CLOUDINARY_UPLOAD_KEY=657115753521274

# Bearer token that guards POST /api/media/upload and /api/media/signature.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MEDIA_UPLOAD_TOKEN=<GENERATE_A_RANDOM_TOKEN>
